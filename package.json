{
  "name": "sliso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Restidskartor för SL – utan initial väntan",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && python scripts/check_dist.py",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:python": "python -m unittest discover -s tests -p '*_test.py'",
    "test:e2e": "playwright test",
    "data:demo": "python scripts/demo.py",
    "data:build": "python scripts/build_data.py",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "leaflet": "^1.9.4"
  }
}
